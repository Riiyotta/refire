{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "refire-int/pagespec.schema.json",
  "title": "Refire /int PageSpec",
  "description": "Machine contract for a page composed from this design-repo. Structure only: JSON Schema cannot cross-check a PageSpec against its template's real node list, word budgets, route/theme bindings, asset roles per mode or copy reuse; schema/semantic_validate.py does that.",
  "type": "object",
  "properties": {
    "pageSpecVersion": {
      "const": "1.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^page\\.[a-z0-9-]+$"
    },
    "template": {
      "type": "string",
      "enum": [
        "template.home",
        "template.not-found"
      ]
    },
    "route": {
      "type": "string",
      "pattern": "^(/|\\*)$",
      "$comment": "only the two real routes exist; ROUTE_TEMPLATE_BINDING pairs them with templates"
    },
    "theme": {
      "type": "string",
      "enum": [
        "theme.refire-dark",
        "theme.system-error"
      ]
    },
    "mode": {
      "$comment": "rule:MODE_CLOSED_ENUM",
      "type": "string",
      "enum": [
        "reference",
        "generated"
      ],
      "description": "Required closed generation context. 'reference' = documented reproduction of the authorized clone (real brand, copy and assets allowed as evidence). 'generated' = a new page for someone else: it must contain nothing that identifies or reproduces the source, and schema/semantic_validate.py rejects it through the GENERATED_MODE_* rules."
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "description"
      ],
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/node"
      }
    }
  },
  "required": [
    "pageSpecVersion",
    "id",
    "template",
    "route",
    "theme",
    "mode",
    "meta",
    "nodes"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "rule:NOT_FOUND_COPY_LOCKED",
      "if": {
        "properties": {
          "template": {
            "const": "template.not-found"
          }
        },
        "required": [
          "template"
        ]
      },
      "then": {
        "properties": {
          "meta": {
            "properties": {
              "title": {
                "const": "404: This page could not be found"
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "assetRole": {
      "$comment": "rule:ASSET_ROLE_CLOSED -- closed vocabulary, mirrors assets/asset-roles.json (reference-only and generation-safe roles alike; which are usable in which mode is decided by availability and the contracts' generatedAssetRoles, in the semantic layer)",
      "type": "string",
      "enum": [
        "brand.logo",
        "brand.favicon",
        "media.hero-video",
        "media.hero-poster",
        "media.scroll-picture",
        "media.shader-picture",
        "media.social-image",
        "document.brochure",
        "font.brand-typeface",
        "ui.icon",
        "brand.logo-placeholder",
        "media.video-placeholder",
        "media.image-generated",
        "document.placeholder",
        "font.system-stack",
        "person.fictional",
        "url.placeholder",
        "copy.original",
        "brand.fictional"
      ]
    },
    "assetRef": {
      "type": "object",
      "properties": {
        "assetRole": {
          "$ref": "#/definitions/assetRole"
        },
        "src": {
          "type": "string",
          "pattern": "^(/int/(images|videos)/[a-z0-9-]+\\.(jpg|png|mp4)|inline-svg:[a-z0-9-]+|placeholder:[a-z]+\\.[a-z-]+)$"
        }
      },
      "required": [
        "assetRole",
        "src"
      ],
      "additionalProperties": false
    },
    "reducedMotionFallback": {
      "$comment": "rule:REDUCED_MOTION_FIELD -- records the fact that the source has no reduced-motion handling; not a recommendation",
      "const": "none-in-source"
    },
    "href.document": {
      "$comment": "rule:HREF_ALLOWED_KINDS -- no http(s)/external links exist or are allowed",
      "type": "string",
      "pattern": "^(/int/files/[a-z0-9-]+\\.pdf|placeholder:document\\.[a-z-]+)$"
    },
    "href.mailto": {
      "$comment": "rule:HREF_ALLOWED_KINDS -- no http(s)/external links exist or are allowed",
      "type": "string",
      "pattern": "^mailto:[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
    },
    "href.tel": {
      "$comment": "rule:HREF_ALLOWED_KINDS -- no http(s)/external links exist or are allowed",
      "type": "string",
      "pattern": "^tel:\\+[0-9]{6,15}$"
    },
