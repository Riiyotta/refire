{
  "version": "1.0.0",
  "$description": "Closed set a generator may instantiate. verify_all.py enforces parity with sections/, primitives/, components/, the schema's settable properties, and assets/asset-roles.json.",
  "templates": [
    "template.home",
    "template.not-found"
  ],
  "sections": [
    "chrome.cookie-pane",
    "chrome.cursor",
    "chrome.footer",
    "chrome.header",
    "chrome.preloader",
    "chrome.scroll-progress",
    "content.event-accordion",
    "content.numbered-statement",
    "content.title-description",
    "error.not-found",
    "hero.video-title",
    "media.scroll-picture",
    "media.text-image-shader",
    "overlay.contact",
    "stats.card-grid",
    "ticker.marquee"
  ],
  "components": [
    "component.accordion",
    "component.cursor-readout",
    "component.gmt-clock",
    "component.marquee",
    "component.section-title",
    "component.shader-picture",
    "component.stat-card"
  ],
  "primitives": [
    "primitive.fill-swap-button",
    "primitive.glass-link",
    "primitive.icon",
    "primitive.line",
    "primitive.link-arrow",
    "primitive.outline-pill-toggle",
    "primitive.reveal",
    "primitive.select-field",
    "primitive.split-text",
    "primitive.text-field",
    "primitive.underline-link"
  ],
  "pageSpecProperties": [
    "id",
    "meta",
    "nodes",
    "pageSpecVersion",
    "provenance",
    "route",
    "template",
    "theme"
  ],
  "nodeProperties": [
    "content",
    "motion",
    "section",
    "variant"
  ],
  "motionProperties": [
    "pattern",
    "reducedMotionFallback",
    "threshold"
  ],
  "assetRoles": [
    "brand.favicon",
    "brand.logo",
    "document.brochure",
    "font.brand-typeface",
    "media.hero-poster",
    "media.hero-video",
    "media.scroll-picture",
    "media.shader-picture",
    "media.social-image",
    "ui.icon"
  ],
  "overridable": {
    "content": "only the fields of the chosen section's contract (sections/<id>.json content.fields), within maxWords/maxChars/min/maxItems",
    "variant": "only the variants a section contract enumerates",
    "motion": "none: pattern/threshold are const-locked per section; reducedMotionFallback is the const 'none-in-source'",
    "style": "none: a PageSpec has no style or token override field (see tokens/llm/token-policy.json)"
  }
}
